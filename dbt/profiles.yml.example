# Copy this to profiles.yml and fill in your Snowflake credentials.
# profiles.yml is gitignored — never commit credentials.

ukri_early_warning:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      password: "{{ env_var('SNOWFLAKE_PASSWORD') }}"
      role: SYSADMIN
      database: UKRI_EWS
      warehouse: COMPUTE_WH
      schema: RAW
      threads: 4
      client_session_keep_alive: false

    prod:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      password: "{{ env_var('SNOWFLAKE_PASSWORD') }}"
      role: SYSADMIN
      database: UKRI_EWS
      warehouse: COMPUTE_WH
      schema: RAW
      threads: 8
      client_session_keep_alive: false
