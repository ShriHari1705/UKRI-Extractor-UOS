# Copy this to profiles.yml and fill in your MotherDuck token.
# profiles.yml is gitignored — never commit credentials.

ukri_early_warning:
  target: dev
  outputs:
    dev:
      type: duckdb
      path: "md:UKRI_EWS?motherduck_token={{ env_var('MOTHERDUCK_TOKEN') }}"
      extensions:
        - motherduck
      schema: RAW
      threads: 4

    prod:
      type: duckdb
      path: "md:UKRI_EWS?motherduck_token={{ env_var('MOTHERDUCK_TOKEN') }}"
      extensions:
        - motherduck
      schema: RAW
      threads: 8
