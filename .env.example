# .env.example — copy to .env and fill in your values
# .env is gitignored — never commit real credentials

# ── Storage ───────────────────────────────────────────────────────────────────
# Set USE_S3=true to cache API pages in S3 instead of local disk
USE_S3=false
S3_BUCKET=ukri-early-warning
S3_PREFIX=raw/ukri_pages
LOCAL_CACHE=cache/ukri_pages
OUTPUT_DIR=outputs

# ── Snowflake ─────────────────────────────────────────────────────────────────
SNOWFLAKE_ACCOUNT=your-account.snowflakecomputing.com
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=UKRI_EWS
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_TABLE=UKRI_PROJECTS

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC_RAW=ukri.projects.raw
KAFKA_TOPIC_TAGGED=ukri.projects.tagged
KAFKA_GROUP_ID=ukri-ews-consumer
